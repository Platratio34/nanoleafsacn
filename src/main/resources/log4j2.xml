<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
    <Appenders>
        <Console name="ConsoleAppender" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %highlight{[%t] %-5level [%logger{1}] %msg%n}{FATAL=white, ERROR=red, WARN=yellow, INFO=magenta, DEBUG=green, TRACE=cyan}" />
        </Console>
        <File name="FileAppender" fileName="logs/latest.log" immediateFlush="true" append="false">
            <PatternLayout pattern="%d{yyy-MM-dd HH:mm:ss.SSS} [%t] %-5level [%logger{1}] %msg%n"/>
        </File>
    </Appenders>
    <Loggers>
        <Logger name="security" level="info" additivity="false">
            <AppenderRef ref="ConsoleAppender" level="warning"/>
            <AppenderRef ref="FileAppender" level="info"/>
        </Logger>

        <Root level="debug">
            <AppenderRef ref="ConsoleAppender" />
            <AppenderRef ref="FileAppender" level="info"/>
        </Root>
    </Loggers>
</Configuration>